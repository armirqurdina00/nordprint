# Lösenord för /admin
ADMIN_PASSWORD=byt-mig
# Slumpmässig lång sträng (minst 16 tecken) som signerar inloggningscookien.
# Skapa en med: openssl rand -hex 32
SESSION_SECRET=byt-till-en-lang-slumpmassig-strang

# Pushnotiser. Skapa nycklarna med: npx web-push generate-vapid-keys
# Utan dem fungerar chatten som vanligt, men utan notiser.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Kontaktadress till push-tjänsterna (https:// eller mailto:). Valfri på Vercel: produktionsadressen används annars.
# VAPID_SUBJECT=

# --- Bara på Vercel (sätts automatiskt när du kopplar lagring i projektet) ---
# Upstash Redis från Vercel Marketplace: sparar allt innehåll
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Vercel Blob: sparar uppladdade bilder och kundfiler.
# Nya butiker kopplas med OIDC och sätter BLOB_STORE_ID; äldre sätter BLOB_READ_WRITE_TOKEN.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
