# Lösenord för /admin
ADMIN_PASSWORD=byt-mig
# Slumpmässig lång sträng (minst 16 tecken) som signerar inloggningscookien.
# Skapa en med: openssl rand -hex 32
SESSION_SECRET=byt-till-en-lang-slumpmassig-strang

# --- Bara på Vercel (sätts automatiskt när du kopplar lagring i projektet) ---
# Upstash Redis från Vercel Marketplace: sparar allt innehåll
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Vercel Blob: sparar uppladdade bilder och kundfiler
# BLOB_READ_WRITE_TOKEN=
